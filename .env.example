# URL del API Dashboard V2 que consume el proxy interno de Next.
# No use el prefijo NEXT_PUBLIC_: esta variable se lee exclusivamente en el servidor.
API_BASE_ADDRESS=https://apidashboardv2.e-city.co/

# Configure este valor en el secret manager del servidor o en .env.local local.
# Nunca lo suba al repositorio ni lo exponga al navegador.
DASHBOARD_API_KEY_ID=
