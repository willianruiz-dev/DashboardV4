# URL del API Dashboard V2 que consume el proxy interno de Next.
# No use el prefijo NEXT_PUBLIC_: esta variable se lee exclusivamente en el servidor.
API_BASE_ADDRESS=https://apidashboardv2.e-city.co/

# Origen histórico que sí expone los archivos de Security.Users.IMG,
# Business.Clients.LOGOIMG e IMG_DENOM. Ya tiene este valor por defecto.
STATIC_FILES_BASE_ADDRESS=https://dashboardv2.e-city.co/

# Configure este valor en el secret manager del servidor o en .env.local local.
# Nunca lo suba al repositorio ni lo exponga al navegador.
DASHBOARD_API_KEY_ID=

# Clave pública RSA del API para RSA-OAEP/SHA-1. Puede usarse PEM multilínea,
# \n escapados o el formato de líneas separadas por _ del frontend legado.
DASHBOARD_RSA_PUBLIC_KEY=

# En producción HTTPS use true. Sólo use false al probar el frontend por HTTP local.
SESSION_COOKIE_SECURE=true
